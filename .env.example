# Lexicon AI Platform - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3000

# AI Service Keys (Phase 2)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Database (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/lexicon

# Authentication (Phase 2)
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here

# Document Storage (Phase 2)
# STORAGE_BUCKET=your_storage_bucket_name
# STORAGE_REGION=us-east-1

# RAG Configuration (Phase 2)
# VECTOR_DB_URL=your_vector_database_url
# EMBEDDING_MODEL=text-embedding-ada-002
